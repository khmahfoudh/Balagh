# Copier ce fichier en backend/.env et remplir les valeurs. Ne jamais versionner .env.

# --- Base de données ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=balagh_db
# Rôle applicatif à droits limités (SELECT/INSERT/UPDATE/DELETE), créé par db/admin/setup_balagh_db.sql
DB_APP_USER=balagh_app
DB_APP_PASSWORD=changer-moi
# Propriétaire de la base, utilisé uniquement par Flyway pour les migrations
DB_MIGRATION_USER=stage_user
DB_MIGRATION_PASSWORD=changer-moi

# --- Sécurité ---
# Au moins 32 caractères aléatoires (ex. : openssl rand -base64 48)
JWT_SECRET=
# Clé AES-256 en Base64, exactement 32 octets (ex. : openssl rand -base64 32)
NNI_ENCRYPTION_KEY=
# Au moins 32 caractères aléatoires
HASH_SECRET=

# --- Application ---
SERVER_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
INVITATION_BASE_URL=http://localhost:4200/activation
STORAGE_LOCAL_DIR=./uploads

# --- Données de démonstration (dev uniquement) ---
DEMO_DATA=true
DEMO_USERS_PASSWORD=
