{
    // Extension « Language Support for Java » (redhat.java) épinglée en 1.55.0 : à partir de la 1.57,
    // son compilateur (ECJ 4.42) signale à tort les constructeurs Lombok (@RequiredArgsConstructor)
    // comme « Flexible Constructor Bodies » et écrit des .class cassés dans target/classes
    // (le backend plante alors au démarrage : « Unresolved compilation problems »).
    // Bugs : redhat-developer/vscode-java#4521, projectlombok/lombok#4084. Réactiver la mise à jour
    // de l'extension quand Lombok publie le correctif.
    "java.configuration.updateBuildConfiguration": "disabled",
    // Seul Maven compile le backend (start-backend.ps1) : l'extension ne doit jamais écrire dans target/.
    "java.autobuild.enabled": false,
    "java.compile.nullAnalysis.mode": "automatic"
}
