# Copier en .env.local (non versionné).
# Adresse du backend vue depuis le téléphone : l'IP du PC sur le Wi-Fi (ipconfig), pas localhost.
# Émulateur Android : http://10.0.2.2:8080
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
# true uniquement dans un build de développement avec une clé Google Maps iOS
EXPO_PUBLIC_IOS_GOOGLE_MAPS=false
# Clés Google Maps (builds EAS uniquement, inutiles dans Expo Go)
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
