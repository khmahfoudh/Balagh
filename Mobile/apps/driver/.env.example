# Copier en .env.local (non versionné).
# Adresse du backend : facultative. Par défaut, le PC qui sert l'app (même IP que Metro, port 8080),
# même si l'IP Wi-Fi change. À définir en production, ou pour l'émulateur Android (http://10.0.2.2:8080).
# EXPO_PUBLIC_API_URL=https://api.balagh.mr
EXPO_PUBLIC_IOS_GOOGLE_MAPS=false
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
